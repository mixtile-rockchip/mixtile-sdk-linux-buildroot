config BR2_PACKAGE_PRODUCTIONTOOL
	bool "ProductionTool (factory / manufacturing test tool)"
	default n

	# Python runtime
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_UNICODEDATA
	select BR2_PACKAGE_PYTHON_CFFI
	select BR2_PACKAGE_PYTHON_DAEMON
	select BR2_PACKAGE_PYTHON_SETUPTOOLS
	select BR2_PACKAGE_PYTHON_PACKAGING
	select BR2_PACKAGE_PYTHON_PYPARSING
	select BR2_PACKAGE_PYTHON_PIP
	select BR2_PACKAGE_PYTHON_NUMPY
	select BR2_PACKAGE_PYTHON_FUTURE
	select BR2_PACKAGE_PYTHON_PARAMIKO
	select BR2_PACKAGE_PYTHON_PILLOW
	select BR2_PACKAGE_PYTHON_QRCODE
	select BR2_PACKAGE_PYTHON_REQUESTS
	select BR2_PACKAGE_PYTHON_SIX
	select BR2_PACKAGE_PYTHON_XMLTODICT
	select BR2_PACKAGE_PYTHON_ECDSA
	select BR2_PACKAGE_PYTHON_BITSTRING
	select BR2_PACKAGE_PYTHON_REEDSOLO
	select BR2_PACKAGE_PYTHON_GIT
	select BR2_PACKAGE_PYTHON_DNSPYTHON
	select BR2_PACKAGE_PYTHON_CRYPTOGRAPHY
	select BR2_PACKAGE_PYTHON_COLORAMA
	select BR2_PACKAGE_PYTHON_PYUSB
	select BR2_PACKAGE_PYTHON_WEBSOCKET_CLIENT

	# PyQt5
	select BR2_PACKAGE_PYTHON_PYQT5_SIP
	select BR2_PACKAGE_PYTHON_PYQT5

	# Qt5 core
	select BR2_PACKAGE_QT5
	select BR2_PACKAGE_QT5BASE
	select BR2_PACKAGE_QT5BASE_GUI
	select BR2_PACKAGE_QT5BASE_WIDGETS
	select BR2_PACKAGE_QT5BASE_OPENGL
	select BR2_PACKAGE_QT5BASE_OPENGL_ES2
	select BR2_PACKAGE_QT5BASE_LINUXFB
	select BR2_PACKAGE_QT5BASE_EGLFS

	# Wayland / Weston
	select BR2_PACKAGE_QT5WAYLAND
	select BR2_PACKAGE_QT5WAYLAND_COMPOSITOR
	select BR2_PACKAGE_WESTON_WAYLAND

	# System / tools
	select BR2_PACKAGE_FIO
	select BR2_PACKAGE_GREP
	select BR2_PACKAGE_UTIL_LINUX_BINARIES

	help
	  ProductionTool is a factory / production test application.
	  It is based on Python3, PyQt5, Qt5 and requires a full
	  graphical stack (Wayland/Weston) and multiple Python
	  runtime modules.
